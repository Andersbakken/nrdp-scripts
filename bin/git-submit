#!/bin/bash

show_help() {
    cat <<'EOF'
git-submit - Selectively submit commits to a branch

USAGE:
    git-submit tracking [BRANCH]
    git-submit changes|list [--branch BRANCH]
    git-submit [OPTIONS] [COMMIT...]
    git-submit [OPTIONS] -a

DESCRIPTION:
    git-submit extracts specific commits from your current branch, rebases them
    onto a target branch, and pushes them. This is useful for submitting a subset
    of commits while keeping others local.

COMMANDS:
    tracking [BRANCH]      Get or set the tracking branch
    changes, list          List commits with [1], [2], ... indices (oldest first)
                           Options: --branch BRANCH

SUBMIT OPTIONS:
    -h, --help             Show this help message
    -n, --dry-run          Show what would be pushed without actually pushing
    -f, --force            Force push
    --force-with-lease     Force push with lease
    -d                     Delete submitted commits from local branch after push
    -a                     Submit all commits that differ from tracking branch.
                           When HEAD is already based on the target branch the
                           commits are pushed as-is, with no rebase, so merge
                           commits are preserved. Otherwise (e.g. when
                           retargeting at another branch) they are rebased onto
                           it as usual, as it also is when the branch has
                           ignored commits (which are skipped) or only sync
                           merges (merging in commits already in the tracking
                           branch, e.g. from `git pull`), which get linearized.
    --flatten-merges       Allow rebasing when merge commits are involved.
                           By default git-submit refuses, since the rebase
                           drops the merge commits and linearizes the merged
                           history (both in what is pushed and, with
                           --no-reset or -d, in the local branch).
    -r, --replace          Replace existing pull request (requires --pr)

    --branch, --src-branch BRANCH
                           Target remote branch to push to (also used to check
                           for existing commits and as base for rebasing)
    --dst-branch BRANCH    Override target branch (takes precedence over --src-branch;
                           default: tracking branch)
    --tracking BRANCH      Override tracking branch for this operation

    --pr, --pull-request NAME
                           Submit to a pull request

    --autostash            Auto-stash uncommitted changes
    --no-reset             Don't reset back to original state after push;
                           leaves submit commits at the beginning of the branch
                           with remaining commits reordered after them
    --reset                Reset back to original state after push (default)
                           Useful to override submit.reset=false config
    --abort-on-failure     Abort rebase on conflict (restores original state)
    --no-abort-on-failure  Leave rebase in progress on conflict for manual resolution
    --no-sync-check        Skip sync check with source branch
    --no-ignore-check      Don't skip commits marked as ignored
    --no-hooks             Skip git hooks (pre-submit, post-submit)

    --                     Treat remaining arguments as commit hashes

COMMIT ARGUMENTS:
    Commits may be given as hashes, revisions, ranges (HASH1..HASH2), or as
    indices into the list of pending commits (those shown by
    'git-submit changes'):
      1, 2, 3 ...    count from the first (oldest) pending commit
      -1, -2, -3 ... count back from the last (newest) pending commit
      1-4           select indices 1 through 4, inclusive (ascending only)
    Indices are resolved at run time, so they keep working after amending a
    commit changes its sha. A plain number that resolves to a real commit or
    ref is treated as that commit rather than as an index.

EXAMPLES:
    # Set tracking branch
    git-submit tracking origin/master

    # List pending commits with indices, then submit selected entries
    git-submit list
    git-submit 1 5

    # Submit specific commits
    git-submit abc123 def456

    # Submit all commits interactively (launches chooser)
    git-submit

    # Submit all commits automatically
    git-submit -a

    # Submit and delete from local branch
    git-submit -d abc123

    # Submit to a pull request
    git-submit --pr my-feature abc123 def456

    # Dry run to see what would be pushed
    git-submit -n abc123

    # Submit commit range
    git-submit abc123..def456

    # Submit the second to last and last pending commits, in that order
    git-submit -2 -1

    # Submit the first three pending commits, in that order
    git-submit 1 2 3

    # Submit the first four pending commits using an inclusive index range
    git-submit 1-4

CONFIGURATION:
    submit.reset           Default reset behavior (default: true)
                           Set to false to default to --no-reset mode
    submit.abortOnFailure  Abort rebase on conflict (default: false)
                           Set to true to auto-abort failed rebases

NOTES:
    - If no commits are specified, an interactive chooser is launched
    - Commits marked as ignored are skipped unless --no-ignore-check is used
    - Git hooks (pre-submit, post-submit) are run if they exist
    - The script uses git rebase internally to extract commits

EOF
    exit 0
}

if test "x$GIT_SEQUENCE_EDITOR" = "x$0" ; then
    # The script was launched as an $EDITOR from git rebase -i.
    # Modify the pick line to an edit line and just exit.
    rm -f /tmp/commits$$
    touch /tmp/commits$$
    if [ "$SUBMIT_CHANGES_MODE" = "keep" ]; then
        for change in $SUBMIT_CHANGES; do
            echo "pick $change" >> /tmp/commits$$
        done
    elif [ "$SUBMIT_CHANGES_MODE" = "reorder" ]; then
        for change in $SUBMIT_CHANGES; do
            echo "pick $change" >> /tmp/commits$$
        done
        grep "^pick " "$1" | while read line; do
            found=
            for change in $SUBMIT_CHANGES; do
                if echo $line | grep --quiet "^pick $change"; then
                    found=1
                    break
                fi
            done
            if [ -z "$found" ]; then
                echo $line >> /tmp/commits$$
            fi
        done
    elif [ "$SUBMIT_CHANGES_MODE" = "delete" ]; then
        grep "^pick " "$1" | while read line; do
            found=
            for change in $SUBMIT_CHANGES; do
                if echo $line | grep --quiet "^pick $change"; then
                    [ "$SUBMIT_CHANGES_MODE" = "delete" ] && echo "drop $change" >> /tmp/commits$$
                    found=1
                    break
                fi
            done
            if [ -z "$found" ]; then
                echo $line >> /tmp/commits$$
            fi
        done
    fi
    cat /tmp/commits$$ > "$1"
    rm -f /tmp/commits$$
    exit 0
fi

GITHOOKSDIR=`git rev-parse --git-path hooks 2>/dev/null`
[ -z "$GITHOOKSDIR" ] && GITHOOKSDIR="$(git rev-parse --git-dir)/hooks"
CURRENTBRANCH=`git branch | grep '^\*' | awk '{print $2}' -`
if test "$CURRENTBRANCH" = "(no" ; then
    echo "Not on a valid branch - please check out the correct branch"
    exit 1
fi

run_hook() {
    [ -d "$GITHOOKSDIR" ] || return 0
    local HOOK_SCRIPT="${GITHOOKSDIR}/${1}"
    #echo "Running hook: ${HOOK_SCRIPT}"
    if [ -x "$HOOK_SCRIPT" ]; then
        shift
        $HOOK_SCRIPT "$@" || return 1
    fi
    return 0
}

TRACKING=`git config --local submit.tracking`
[ -z "$TRACKING" ] && TRACKING=`git tracking`
echo "Tracking branch: $TRACKING"

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    show_help
elif [ "$1" = "tracking" ]; then
    if [ -n "$2" ]; then
        git config --local submit.tracking "$2"
    else
        echo "$TRACKING"
    fi
elif [ "$1" = "changes" ] || [ "$1" = "list" ]; then
    BRANCH=""
    while [ "$#" -ge 1 ]; do
        if [ "$1" = "--branch" ]; then
            shift
            BRANCH="$1"
        fi
        shift
    done
    [ -z "$BRANCH" ] && BRANCH="$TRACKING"

    INDEX=0
    for change in `git cherry $BRANCH | grep '^+ ' | sed 's,^+,,g'`; do
        [ "$change" = "+" ] && continue
        NOTES=
        git ignore-commit check "$change" >/dev/null && NOTES="$NOTES [IGNORED]"
        INDEX=$((INDEX + 1))
        printf '[%d] %s\n' "$INDEX" "$(git changes --no-ignores --max-count=1 $change)$NOTES"
    done
else
    PR=""
    SRC_BRANCH=""
    DST_BRANCH="$TRACKING"
    ALL=no
    IN_CHANGES=
    DELETE=no
    FORCE=
    REPLACE=no
    PUSH=yes
    IGNORE_CHECK=yes
    SYNC_CHECK=yes
    AUTOSTASH=
    FLATTEN_MERGES=
    OPERATION=`git config submit.operation`
    if [ "$OPERATION" = "0" ] || [ "$OPERATION" = "false" ]; then
        OPERATION=
    fi
    [ "`git config submit.autostash`" != "false" ] && AUTOSTASH="yes"
    RESET_DEFAULT=`git config submit.reset`
    if [ "$RESET_DEFAULT" = "false" ] || [ "$RESET_DEFAULT" = "0" ]; then
        NO_RESET=yes
    fi
    ABORT_ON_FAILURE_DEFAULT=`git config submit.abortOnFailure`
    if [ "$ABORT_ON_FAILURE_DEFAULT" = "true" ] || [ "$ABORT_ON_FAILURE_DEFAULT" = "1" ]; then
        ABORT_ON_FAILURE=yes
    fi
    while [ "$#" -ge 1 ]; do
        if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
            show_help
        elif [ "$1" = "-n" ] || [ "$1" = "--dry-run" ]; then
            PUSH=no
        elif [ "$1" = "-f" ] || [ "$1" = "--force" ];  then
            FORCE="-f"
        elif [ "$1" = "--force-with-lease" ];  then
            FORCE="--force-with-lease"
        elif [ "$1" = "-d" ]; then
            DELETE=yes
        elif [ "$1" = "--branch" ] || [ "$1" = "--src-branch" ]; then
            shift
            SRC_BRANCH="$1"
        elif [ "$1" = "--tracking" ]; then
            shift
            TRACKING="$1"
        elif [ "$1" = "--dst-branch" ]; then
            shift
            DST_BRANCH="$1"
        elif [ "$1" = "--pr" ] || [ "$1" = "--pull-request" ]; then
            shift
            PR="$1"
        elif [ "$1" = "--replace" ] || [ "$1" = "-r" ]; then
            REPLACE=yes
        elif [ "$1" = "--autostash" ]; then
            AUTOSTASH="yes"
        elif [ "$1" = "--no-sync-check" ]; then
            SYNC_CHECK="no"
        elif [ "$1" = "--no-ignore-check" ]; then
            IGNORE_CHECK="no"
        elif [ "$1" = "--no-hooks" ]; then
            GITHOOKSDIR=""
        elif [ "$1" = "--no-reset" ]; then
            NO_RESET=yes
        elif [ "$1" = "--reset" ]; then
            NO_RESET=
        elif [ "$1" = "--abort-on-failure" ]; then
            ABORT_ON_FAILURE=yes
        elif [ "$1" = "--no-abort-on-failure" ]; then
            ABORT_ON_FAILURE=
        elif [ "$1" = "-a" ]; then
            ALL=yes
        elif [ "$1" = "--flatten-merges" ]; then
            FLATTEN_MERGES=yes
        elif [ "$1" = "--" ]; then
            shift
            IN_CHANGES="$IN_CHANGES $@"
            break
        elif [[ "$1" =~ ^-[0-9]+$ ]]; then
            IN_CHANGES="$IN_CHANGES $1"
        elif `echo $1 | grep --quiet -- "^-"`; then
            echo "git-submit: Unknown option $1" >&2
            exit 1
        else
            IN_CHANGES="$IN_CHANGES $1"
        fi
        shift
    done
    # Merges in range $1 that carry history of their own. A "sync merge" -- a
    # local merge that only brings in commits already in $TRACKING, e.g. from
    # a `git pull` without rebase -- is left out: flattening it loses nothing.
    real_merges() {
        local merge parent real
        for merge in `git rev-list --merges "$1"`; do
            real=
            if git merge-base --is-ancestor "$merge" "$TRACKING" 2>/dev/null; then
                real=yes
            else
                for parent in `git rev-parse "${merge}^@" | tail -n +2`; do
                    git merge-base --is-ancestor "$parent" "$TRACKING" 2>/dev/null || real=yes
                done
            fi
            [ -n "$real" ] && git rev-parse --short "$merge"
        done | xargs
    }

    SUBMIT_ALL=no
    if [ "$ALL" = "yes" ] && [ -n "$TRACKING" ]; then
        # -a means "submit the whole branch", so there is nothing to select or
        # reorder. When HEAD is already based on the destination we push HEAD
        # as-is instead of rebasing: it is faster, and it preserves merge
        # commits, which `git cherry` (--no-merges) and `git rebase -i` would
        # otherwise silently drop.
        # If HEAD is not a descendant of the destination the branch is being
        # retargeted at a different tracking branch, and we still need to
        # rebase the commits onto it.
        # The destination (--src-branch/--dst-branch, if it exists) must also
        # be based on $TRACKING, otherwise pushing HEAD would drag all of
        # $TRACKING into it (e.g. -a --dst-branch origin/release on master).
        ALL_BASE="${SRC_BRANCH:-$DST_BRANCH}"
        if [ -n "$FORCE" ] || ! git rev-parse --verify --quiet "$ALL_BASE" >/dev/null; then
            ALL_BASE="$TRACKING"
        fi
        if ! git merge-base --is-ancestor "$TRACKING" HEAD 2>/dev/null; then
            echo "HEAD is not based on $TRACKING, changes need to be rebased onto it"
        elif ! git merge-base --is-ancestor "$ALL_BASE" HEAD 2>/dev/null || ! git merge-base --is-ancestor "$TRACKING" "$ALL_BASE" 2>/dev/null; then
            echo "HEAD can't be pushed as-is to $ALL_BASE, changes need to be rebased onto it"
        elif [ -z "`git rev-list -1 "${ALL_BASE}..HEAD"`" ]; then
            echo "Nothing to submit (HEAD is already in $ALL_BASE)."
            exit 0
        else
            SUBMIT_ALL=yes
        fi
    fi
    if [ "$SUBMIT_ALL" = "yes" ]; then
        # Pushing as-is can't skip anything, so fall back to rebasing when the
        # branch has ignored commits, or when its only merges are sync merges
        # (linearizing those is what -a always did).
        IGNORED_CHANGES=
        if [ "$IGNORE_CHECK" = "yes" ]; then
            for change in `git rev-list --no-merges "${TRACKING}..HEAD"`; do
                git ignore-commit check "$change" >/dev/null && IGNORED_CHANGES="$IGNORED_CHANGES `git rev-parse --short $change`"
            done
        fi
        if [ -n "$IGNORED_CHANGES" ]; then
            echo "Skipping ignored commit(s)${IGNORED_CHANGES}, changes need to be rebased (--no-ignore-check pushes them as-is)"
            SUBMIT_ALL=no
        elif [ -n "`git rev-list --merges -1 "${TRACKING}..HEAD"`" ] && [ -z "`real_merges "${TRACKING}..HEAD"`" ]; then
            echo "Only sync merges of $TRACKING in branch, changes will be rebased to linearize them"
            SUBMIT_ALL=no
        fi
    fi
    if [ "$ALL" = "yes" ] && [ "$SUBMIT_ALL" != "yes" ]; then
        for change in `git cherry "$TRACKING" | grep '^+ ' | sed 's,^+,,g'`; do
            IN_CHANGES="$IN_CHANGES `echo $change | awk '{print $1}'`"
        done
    fi
    if [ -n "$PR" ]; then
        PR_ARGS=""
        [ -n "$PR" ] && PR_ARGS="$PR_ARGS --name $PR"
        [ "$REPLACE" = "yes" ] && PR_ARGS="$PR_ARGS --force"
        [ "$SUBMIT_ALL" = "yes" ] && PR_ARGS="$PR_ARGS -a"
        [ "$FLATTEN_MERGES" = "yes" ] && PR_ARGS="$PR_ARGS --flatten-merges"
        git pullrequest submit ${PR_ARGS} ${IN_CHANGES}
        exit 0
    elif [ "$REPLACE" = "yes" ]; then
        echo "--replace only works with --pr"
        exit 1
    fi
    autostash() {
        if [ -n "$AUTOSTASH" ] && [ -n "`git status -s -uno 2>/dev/null`" ]; then
            ignore_marker=`git ignore-commit marker 2>/dev/null`
            git commit -a -m "${ignore_marker}git-submit" --allow-empty
            return 0
        fi
        return 1
    }
    if [ "$SYNC_CHECK" = "yes" ] && [ -n "$SRC_BRANCH" ] && ! git sync --check "$SRC_BRANCH" >/dev/null 2>&1; then
        echo "You need to sync first! [$SRC_BRANCH]" >&2
        exit 1
    fi

    if [ -z "$SRC_BRANCH" ]; then
        SRC_BRANCH="$DST_BRANCH"
    fi
    if [ -z "$SRC_BRANCH" ]; then
        echo "No branch to push to!"
        exit 1
    fi

    COMMON_SHA1_BRANCH="$SRC_BRANCH"
    git rev-parse "$COMMON_SHA1_BRANCH" >/dev/null 2>&1 || COMMON_SHA1_BRANCH="$TRACKING"
    COMMON_SHA1=`git merge-base HEAD $COMMON_SHA1_BRANCH`

    if [ -z "$IN_CHANGES" ] && [ "$SUBMIT_ALL" != "yes" ]; then
        SUBMIT_ARGS="--tracking ${TRACKING}"
        #SUBMIT_ARGS="${SUBMIT_ARGS} --no-hooks"
        [ -n "$FORCE" ] && SUBMIT_ARGS="$SUBMIT_ARGS $FORCE"
        [ "$DELETE" = "yes" ] && SUBMIT_ARGS="$SUBMIT_ARGS -d"
        [ -n "$SRC_BRANCH" ] && SUBMIT_ARGS="$SUBMIT_ARGS --src-branch ${SRC_BRANCH}"
        [ -n "$DST_BRANCH" ] && SUBMIT_ARGS="$SUBMIT_ARGS --dst-branch ${DST_BRANCH}"
        [ "$SYNC_CHECK" != "yes" ] && SUBMIT_ARGS="$SUBMIT_ARGS --no-sync-check"
        [ "$IGNORE_CHECK" != "yes" ] && SUBMIT_ARGS="$SUBMIT_ARGS --no-ignore-check"
        which git-choose-show-change >/dev/null 2>&1 && git-choose-show-change --filter "$SRC_BRANCH" --reverse --command "submit ${SUBMIT_ARGS}" "${TRACKING}..HEAD"
        exit 0
    else
        RESOLVED_CHANGES=""
        PENDING_CHANGES=()
        pending_change() {
            # 1 is the first (oldest) pending commit, 2 the next one, etc.
            # -1 is the last (newest) pending commit, -2 the one before it, etc.
            local index="${1#-}"
            local count
            if [ "${#PENDING_CHANGES[@]}" = "0" ]; then
                PENDING_CHANGES=(`git cherry "$TRACKING" | grep '^+ ' | awk '{print $2}'`)
            fi
            count="${#PENDING_CHANGES[@]}"
            if [ "$index" = "0" ] || [ "$index" -gt "$count" ]; then
                echo "git-submit: No such pending commit '$1' ($count pending vs ${TRACKING})" >&2
                return 1
            fi
            if [ "$1" = "$index" ]; then
                echo "${PENDING_CHANGES[$((index - 1))]}"
            else
                echo "${PENDING_CHANGES[$((count - index))]}"
            fi
        }
        for change in $IN_CHANGES; do
            if [[ "$change" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                FIRST_INDEX=$((10#${BASH_REMATCH[1]}))
                LAST_INDEX=$((10#${BASH_REMATCH[2]}))
                if [ "$FIRST_INDEX" -gt "$LAST_INDEX" ]; then
                    echo "git-submit: Index range '$change' must be ascending" >&2
                    exit 1
                fi
                for ((INDEX=FIRST_INDEX; INDEX<=LAST_INDEX; INDEX++)); do
                    SHA1=$(pending_change "$INDEX") || exit 1
                    RESOLVED_CHANGES="$RESOLVED_CHANGES $SHA1"
                done
            elif [[ "$change" =~ ^-[0-9]+$ ]]; then
                SHA1=$(pending_change "$change") || exit 1
                RESOLVED_CHANGES="$RESOLVED_CHANGES $SHA1"
            elif [[ "$change" =~ ^[0-9]+$ ]] && ! git rev-parse --verify --quiet "${change}^{commit}" >/dev/null 2>&1; then
                SHA1=$(pending_change "$change") || exit 1
                RESOLVED_CHANGES="$RESOLVED_CHANGES $SHA1"
            elif echo "$change" | grep -q '\.\.'; then
                # Range notation (e.g., HASH1..HASH2) - expand using git log
                RANGE_COMMITS=$(git log --reverse --pretty='%H' "$change" 2>/dev/null)
                if [ $? -ne 0 ] || [ -z "$RANGE_COMMITS" ]; then
                    echo "git-submit: Failed to resolve range '$change'" >&2
                    exit 1
                fi
                for SHA1 in $RANGE_COMMITS; do
                    RESOLVED_CHANGES="$RESOLVED_CHANGES $SHA1"
                done
            else
                SHA1=$(git rev-parse "$change" 2>/dev/null)
                if [ $? -ne 0 ] || [ -z "$SHA1" ]; then
                    echo "git-submit: Failed to resolve commit '$change'" >&2
                    exit 1
                fi
                RESOLVED_CHANGES="$RESOLVED_CHANGES $SHA1"
            fi
        done
        IN_CHANGES="$RESOLVED_CHANGES"
    fi

    AUTOSTASHED=0
    RESET_HEAD=`git rev-parse HEAD`
    if [ "$SUBMIT_ALL" = "yes" ]; then
        # The whole branch, already based on the destination: push HEAD as-is.
        # No rebase means merge commits survive, and there is nothing to stash
        # or reset afterwards since HEAD never moves.
        NEW_SHA1="$RESET_HEAD"
        NO_RESET=yes
        COMMON_SHA1=`git merge-base HEAD "$ALL_BASE"`
        CHANGES=`git log --reverse --pretty='%h' "${COMMON_SHA1}..HEAD" | tr '\n' ' '`
        export SUBMIT_CHANGES="$CHANGES"
        echo "Submit ${CHANGES}on top of ${COMMON_SHA1} (no rebase)"
    else
        CHANGES=""
        SELECTED_MERGES=""
        for change in $IN_CHANGES; do
            SHA1=`git rev-parse --short "$change"`
            if ! git merge-base "$SHA1" HEAD >/dev/null 2>/dev/null ; then
                echo "$SHA1 does not appear to be in the current branch"
                continue
            elif [ "$IGNORE_CHECK" = "yes" ] && git ignore-commit check "$SHA1" >/dev/null; then
                echo "$SHA1 is marked to ignore!"
                continue
            elif git rev-parse --verify --quiet "${SHA1}^2" >/dev/null; then
                # A merge commit can't be picked by a (non --rebase-merges) rebase.
                SELECTED_MERGES="$SELECTED_MERGES $SHA1"
                continue
            fi
            # Only filter against the branch we build on: when submitting to
            # another branch (--dst-branch origin/release) commits that are
            # already in $TRACKING are exactly what is being submitted.
            FILTER_CHERRY=$(git cherry "$COMMON_SHA1_BRANCH" "${SHA1}" "${SHA1}~" 2>/dev/null)
            if [ -z "${FILTER_CHERRY}" ] || echo "$FILTER_CHERRY" | grep -q '^-'; then
                echo "Filtered: ${SHA1} (already present in ${COMMON_SHA1_BRANCH})" >&2
                continue
            fi
            CHANGES="$CHANGES $SHA1"
        done

        # Build on top of the existing destination branch (unless forcing).
        # Using it as the --onto base keeps its history, merges included, as-is.
        ONTO_SHA1="$COMMON_SHA1"
        if [ -z "$FORCE" ] && git rev-parse --verify --quiet "$SRC_BRANCH" >/dev/null; then
            ONTO_SHA1=`git rev-parse "$SRC_BRANCH"`
        fi

        # Refuse to silently flatten merge commits. That happens when a merge
        # is selected (directly or via a range), when -a has to rebase our
        # own merges, or when the local branch is rewritten (--no-reset / -d).
        if [ "$FLATTEN_MERGES" != "yes" ]; then
            BRANCH_MERGES=
            if [ "$NO_RESET" = "yes" ] || [ "$DELETE" = "yes" ]; then
                BRANCH_MERGES=`real_merges "${COMMON_SHA1}..HEAD"`
            elif [ "$ALL" = "yes" ]; then
                BRANCH_MERGES=`real_merges "${TRACKING}..HEAD"`
            fi
            if [ -n "$SELECTED_MERGES" ] || [ -n "$BRANCH_MERGES" ]; then
                echo "git-submit: refusing to rebase merge commits, this would flatten them:" >&2
                [ -n "$SELECTED_MERGES" ] && echo "    selected:${SELECTED_MERGES}" >&2
                if [ -n "$BRANCH_MERGES" ]; then
                    if [ "$NO_RESET" = "yes" ] || [ "$DELETE" = "yes" ]; then
                        echo "    in local branch (rewritten by --no-reset/-d): ${BRANCH_MERGES}" >&2
                        echo "Use --reset to leave the local branch untouched." >&2
                    else
                        echo "    in branch (-a, needs to be rebased onto ${COMMON_SHA1_BRANCH}): ${BRANCH_MERGES}" >&2
                    fi
                    if [ "$ALL" = "yes" ]; then
                        if [ -n "$IGNORED_CHANGES" ]; then
                            echo "Drop the ignored commit(s)${IGNORED_CHANGES}, or pass --no-ignore-check, so -a can push the branch as-is." >&2
                        elif [ "$COMMON_SHA1_BRANCH" = "$TRACKING" ]; then
                            echo "Sync with ${TRACKING} first so -a can push the branch as-is." >&2
                        else
                            echo "-a only pushes the branch as-is when HEAD is based on ${COMMON_SHA1_BRANCH} and it contains ${TRACKING}." >&2
                        fi
                    fi
                fi
                echo "Pass --flatten-merges to rebase anyway (merge commits are dropped, merged commits are linearized)." >&2
                exit 1
            fi
        elif [ -n "$SELECTED_MERGES" ]; then
            echo "Flattening: skipping merge commit(s)${SELECTED_MERGES}" >&2
        fi

        if [ -z "$CHANGES" ]; then
            echo "Nothing to submit (no selected commits remain)."
            exit 0
        fi

        autostash && AUTOSTASHED=$((AUTOSTASHED+1))
        RESET_HEAD=`git rev-parse HEAD`

        export SUBMIT_CHANGES="$CHANGES"
        if [ "$NO_RESET" = "yes" ]; then
            export SUBMIT_CHANGES_MODE="reorder"
        else
            export SUBMIT_CHANGES_MODE="keep"
        fi
        export GIT_SEQUENCE_EDITOR="$0"
        echo "$(printf "%s" "$SUBMIT_CHANGES_MODE" | cut -c1 | tr '[:lower:]' '[:upper:]')$(printf "%s" "$SUBMIT_CHANGES_MODE" | cut -c2-) ${SUBMIT_CHANGES} onto ${ONTO_SHA1}"
        #exit 0
        [ -n "$OPERATION" ] && git operation save
        if ! git rebase --keep-empty -i --onto "${ONTO_SHA1}" "${COMMON_SHA1}"; then
            echo "Git failed"
            if [ "$ABORT_ON_FAILURE" = "yes" ]; then
                echo "Aborting rebase..."
                git rebase --abort
                git reset --hard "${RESET_HEAD}"
                [ "$AUTOSTASHED" -gt 0 ] && git reset "HEAD~${AUTOSTASHED}"
            fi
            [ -n "$OPERATION" ] && git operation pop
            exit 1
        fi
        if [ "$NO_RESET" = "yes" ]; then
            SUBMIT_COUNT=$(echo $SUBMIT_CHANGES | wc -w)
            TOTAL_COUNT=$(git rev-list --count "${ONTO_SHA1}..HEAD")
            SKIP_COUNT=$((TOTAL_COUNT - SUBMIT_COUNT))
            NEW_SHA1=`git rev-parse "HEAD~${SKIP_COUNT}"`
        else
            NEW_SHA1=`git rev-parse HEAD`
        fi
    fi
    if [ -z "$NEW_SHA1" ]; then
        echo "Nothing to push"
        DELETE="no"
    else
        PUSH_ORIGIN="."
        PUSH_BRANCH="$DST_BRANCH"
        [ -z "$PUSH_BRANCH" ] && PUSH_BRANCH="$SRC_BRANCH"
        if echo "$PUSH_BRANCH" | grep -q "/"; then
            PUSH_ORIGIN=`echo $PUSH_BRANCH | cut -d/ -f1`
            PUSH_BRANCH=`echo $PUSH_BRANCH | cut -d/ -f2-`
        fi
        PUSH_ARGS="$PUSH_ORIGIN $NEW_SHA1:refs/heads/$PUSH_BRANCH"
        [ -n "$FORCE" ] && PUSH_ARGS="$FORCE ${PUSH_ARGS}"
        echo "Push: git push $PUSH_ARGS"

        if [ "$PUSH" = "yes" ] && run_hook "pre-submit" "$NEW_SHA1" "$SRC_BRANCH"; then
            if git push ${PUSH_ARGS}; then
                run_hook "post-submit" "$COMMON_SHA1" "$SRC_BRANCH" "$TRACKING"
            else
                DELETE="no"
            fi
        fi
    fi
    if [ "$NO_RESET" != "yes" ]; then
        git reset --hard "${RESET_HEAD}"
        if [ "$DELETE" = "yes" ] && [ "$PUSH" = "yes" ]; then
            export SUBMIT_CHANGES="$CHANGES"
            export SUBMIT_CHANGES_MODE="delete"
            echo "Delete ${SUBMIT_CHANGES} from ${COMMON_SHA1}"
            git rebase -i "${COMMON_SHA1}" >/dev/null
        fi
    fi
    [ "$AUTOSTASHED" -gt 0 ] && git reset "HEAD~${AUTOSTASHED}"
    [ -n "$OPERATION" ] && git operation pop
fi
exit 0
